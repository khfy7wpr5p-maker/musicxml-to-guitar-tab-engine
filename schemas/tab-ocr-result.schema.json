{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.seslitab.local/tab-ocr-result-1.0.0.json",
  "title": "SesliTab TAB OCR Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engine", "document", "pages", "warnings", "requiresTeacherReview"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "seslitab-tab-ocr" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "pageCount"],
      "properties": {
        "sourceType": { "enum": ["pdf", "png", "jpg", "unknown"] },
        "pageCount": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requiresTeacherReview": { "const": true }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageNumber", "systems"],
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1 },
        "systems": {
          "type": "array",
          "items": { "$ref": "#/$defs/system" }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemNumber", "strings", "events", "confidence"],
      "properties": {
        "systemNumber": { "type": "integer", "minimum": 1 },
        "strings": { "const": 6 },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "notes"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/note" }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["string", "fret", "confidence"],
      "properties": {
        "string": { "type": "integer", "minimum": 1, "maximum": 6 },
        "fret": { "type": "integer", "minimum": 0, "maximum": 24 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
